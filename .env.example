# Copy to .env and fill in. With no keys, the game runs in fake mode on canned responses.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# Force fake mode even when keys are present (1 = on)
WB_FAKE=0
# Text backend: anthropic (Claude API, Sonnet 5.5), claude (local Claude Code CLI on your subscription; local play only), or openai
WB_LLM=anthropic
# ElevenLabs guards: 1 = dry run (log, send nothing). Budget = max real credits, totalled from server/voice_ledger.jsonl
WB_VOICE_DRY=1
WB_VOICE_BUDGET=1000
